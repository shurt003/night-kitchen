# --- App auth (users + their passwords/capture keys live in the `users` table) ---
APP_PASSWORD=change-me                     # server secret that signs login cookies — long and random, not a login password
CAPTURE_API_KEY=change-me-too              # legacy; only the /health page checks it

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co   # your project URL
SUPABASE_SERVICE_ROLE_KEY=eyJ...                    # service_role secret — server-side only, never exposed to the browser

# --- Anthropic (console.anthropic.com → API keys) ---
ANTHROPIC_API_KEY=sk-ant-...               # used for extraction, tagging, categorization, planning, chat

# --- Voyage AI (voyageai.com — Anthropic's recommended embeddings partner) ---
VOYAGE_API_KEY=pa-...                      # OPTIONAL: powers semantic search; keyword search works without it
